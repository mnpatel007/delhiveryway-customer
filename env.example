# ============================================================
# Customer frontend env vars — set in Vercel → Project → Environment.
# All values are PUBLIC (baked into the client bundle) — never put server
# secrets here. For local dev use .env.development (localhost-only).
# ============================================================

# ── Backend endpoints ──
REACT_APP_API_URL=""
REACT_APP_BACKEND_URL=""
REACT_APP_SOCKET_URL=""

# ── Public client keys (safe in frontend) ──
REACT_APP_STRIPE_PUBLISHABLE_KEY=""
REACT_APP_GOOGLE_CLIENT_ID=""

# ── App identity ──
REACT_APP_APP_NAME=""
REACT_APP_APP_VERSION=""
REACT_APP_APP_ENV=""
